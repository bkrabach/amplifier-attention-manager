// attention-manager — an Amplifier bundle that watches long-running work,
// notices when a human decision is actually needed, and escalates it as a
// small "packet" a person can answer, instead of letting the work stall silently.

digraph attention_manager {
    rankdir=LR
    fontname="Helvetica"
    fontsize=12
    label="Attention Manager v0.1.0\nKnows when to interrupt a human — turns stalled work into answerable decision packets"
    labelloc=t
    labeljust=c
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="c19e9411fa1dc4064ecf70948cc8f2db1b259a15d821da1c7c435e58b81fbe43"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    root_attention_manager [label="Attention Manager (main entry point)\nv0.1.0 · 0 tools · 0 agents\n~402 tok aggregate", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", penwidth=2]

    subgraph cluster_behaviors {
        label="Behaviors — reusable skill packs added to a session"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        beh_attention_manager_behavior [label="Core Attention Behavior\nTeaches the assistant when work needs a human\n1 tools · 1 ctx · ~631 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
        beh_packet_escalation [label="Decision Escalation\nRaises a blocked question to a person and waits\n2 tools · ~304 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
    }

    subgraph cluster_standalones {
        label="Ready-to-Run Bundles — complete configurations you can start directly"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        sta_attention_test_worker [label="Test Worker\nDoes sample work to exercise the system", shape=box, fillcolor="#80cbc4", style="filled,rounded"]
        sta_attention_triage [label="Triage Assistant\nSorts incoming items and decides what to escalate", shape=box, fillcolor="#80cbc4", style="filled,rounded"]
    }

    subgraph cluster_modules {
        label="Modules — the working code behind the behaviors"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        mod_hooks_packet_approval [label="Approval Watcher\nPauses the work until a person responds", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
        mod_tool_request_decision [label="Ask-a-Human Tool\nSends the question and returns the answer\n1 tool · ~334 tok", shape=box, fillcolor="#bbdefb", style="filled,rounded"]
    }

    subgraph cluster_context {
        label="Reference Notes — background the assistant reads"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        ctx_attention_manager_awareness_md [label="How & When To Ask For Attention\nattention-manager-awareness.md\n~279 tok", shape=box, fillcolor="#e1bee7", style="filled,rounded"]
    }

    subgraph cluster_legend {
        label="Legend — what each color means"
        style="filled"
        fillcolor="white"
        color="#cccccc"
        fontsize=9

        leg_root [label="main entry point", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", fontsize=9]
        leg_behavior [label="behavior (skill pack)", shape=box, fillcolor="#e0f2f1", style="filled,rounded", fontsize=9]
        leg_agent [label="agent (specialist helper)", shape=box, fillcolor="#c8e6c9", style="filled,rounded", fontsize=9]
        leg_module [label="module (working code)", shape=box, fillcolor="#bbdefb", style="filled,rounded", fontsize=9]
        leg_provider [label="provider (AI model source)", shape=box, fillcolor="#e0e0e0", style="filled,rounded", fontsize=9]
        leg_context [label="context (reference notes)", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_standalone [label="ready-to-run bundle", shape=box, fillcolor="#80cbc4", style="filled,rounded", fontsize=9]
        leg_experiment [label="experiment (in progress)", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_ext_cost [label="outside repo, adds cost", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2, fontsize=9]
        leg_ext_muted [label="outside repo, no cost", shape=box, fillcolor="#f5f5f5", style="dashed", fontsize=9]
    }

    disclaimer [label="\"Tokens\" = how much reading material this adds for the AI (~4 chars/token)\nSolid border = lives in this repo (counted here)\nDashed + red = comes from elsewhere, adds cost not counted here\nDashed + muted = comes from elsewhere, adds no cost\nNot included: work done by spawned sub-sessions, anything decided at runtime", shape=note, fillcolor="#eceff1", style="filled", fontsize=9]

    ext_githttps___github_com_microsoft_amplifier_foundation_main [label="Amplifier Foundation\nShared base everything builds on\n(from another repo, adds cost)", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2]

    root_attention_manager -> ext_githttps___github_com_microsoft_amplifier_foundation_main [style=dashed]
    root_attention_manager -> beh_attention_manager_behavior [label="composes"]
    beh_attention_manager_behavior -> ctx_attention_manager_awareness_md [style=dotted, color=purple]
    beh_packet_escalation -> mod_tool_request_decision [label="uses", penwidth=0.8]
    beh_packet_escalation -> mod_hooks_packet_approval [label="uses", penwidth=0.8]
    root_attention_manager -> ctx_attention_manager_awareness_md [style=dotted, color=purple]
    sta_attention_test_worker -> root_attention_manager [label="extends", style=dashed]
    sta_attention_triage -> root_attention_manager [label="extends", style=dashed]
}