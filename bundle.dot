// This repository packages the Attention Manager: an assistant that watches ongoing work, decides the rare moments a human decision is actually required, asks that one question, and records the answer so the same question answers itself next time.
digraph attention_manager {
    rankdir=LR
    fontname="Helvetica"
    fontsize=12
    label="Attention Manager v0.1.0\nKnows when work needs a human — asks once, then remembers the answer"
    labelloc=t
    labeljust=c
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="bedd84018daa4f3f47904539ae9147dd490ae441a751e3d8a068142d81a5b0c3"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

