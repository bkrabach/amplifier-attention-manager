        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        agt_triage [label="Triage Specialist\nDecides: handle it, or ask a person\n~162 tok desc", shape=box, fillcolor="#c8e6c9", style="filled,rounded"]
    }

    subgraph cluster_modules {
        label="Modules — Plug-In Code Components"
        style="filled"
